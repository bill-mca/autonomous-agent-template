# Copy this file to .env and fill in the values.
# Describe every variable in README.md.

# Ralph loop settings (all optional).
# RALPH_MAX_TICKS=0                            # stop after this many ticks; 0 means no limit
# RALPH_REFLECT_EVERY=10                       # run a reflection on every Nth tick
# RALPH_MAX_FAILURES=3                         # stop after this many failed ticks in a row
# RALPH_CLAUDE_ARGS="--permission-mode auto"   # extra arguments passed to claude -p
